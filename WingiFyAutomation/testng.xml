<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Wingify Login Suite" parallel="none" verbose="1">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>
    <test name="Invalid Login">
        <classes>
            <class name="com.wingify.automation.tests.InvalidLoginTest"/>
        </classes>
    </test>
    <test name="Valid Login">
        <classes>
            <class name="com.wingify.automation.tests.ValidLoginTest"/>
        </classes>
    </test>
</suite>